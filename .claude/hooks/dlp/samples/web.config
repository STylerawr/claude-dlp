<?xml version="1.0" encoding="utf-8"?>
<!-- Sample .NET web.config for trying the dlp hook. All values are fake. -->
<configuration>
  <appSettings>
    <add key="ServiceName" value="sample-service" />
    <add key="ApiKey" value="sample-xml-api-key-NOT-REAL" />
  </appSettings>
  <connectionStrings>
    <add name="Default" connectionString="Server=localhost;Database=sample;User ID=sa;Password=sample-xml-conn-password-NOT-REAL" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.net>
    <mailSettings>
      <smtp from="noreply@example.com">
        <network host="smtp.example.com" userName="mailer" password="sample-xml-smtp-password-NOT-REAL" />
      </smtp>
    </mailSettings>
  </system.net>
  <credentials>
    <username>sample_admin</username>
    <Password>sample-xml-element-password-NOT-REAL</Password>
    <pw><![CDATA[sample-xml-cdata-pw-NOT-REAL]]></pw>
  </credentials>
</configuration>
