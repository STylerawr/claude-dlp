# Sample .env for trying the dlp hook. All values are fake.
# Files named .env / .env.* are always in scope, regardless of directory.

APP_NAME=sample-app
DB_HOST=localhost
DB_USER=sample_user
DB_PASSWORD=sample-env-db-password-NOT-REAL
export API_KEY="sample-env-api-key-NOT-REAL"
SESSION_SECRET='sample-env-session-secret-NOT-REAL'
